# --- CORE SYSTEM CONFIG ---
PORT=3001

# --- GOOGLE GEMINI AI CONFIG ---
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- DATABASE CONFIG (SUPABASE POSTGRESQL) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If not supplied, the server will fallback to a local JSON database at 'server/data/fallback_db.json'
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# --- AUTHENTICATION (CLERK CONFIG) ---
# If Clerk keys are not supplied, the app will fallback to local Mock Authentication automatically.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- STORAGE (CLOUDINARY CONFIG) ---
# If Cloudinary keys are not supplied, the generator will fallback to Unsplash themed food photo assets.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
